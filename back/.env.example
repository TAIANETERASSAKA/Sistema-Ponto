# ── Banco de dados (no Docker, DB_HOST=db) ────────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_USER=ponto
DB_PASS=
DB_NAME=ponto

# ── Aplicação ─────────────────────────────────────────────────────────────
PORT=7080
FRONTEND_URL=http://localhost:8090
BACKEND_URL=http://localhost:7080
# Texto aleatório e longo (ex: openssl rand -hex 32)
SESSION_SECRET=
# Chave para criptografar dados pessoais. NÃO troque depois de cadastrar usuários.
DATA_ENCRYPTION_KEY=
# true quando o sistema estiver publicado em HTTPS
COOKIE_SECURE=false
# false desliga lembretes e fechamento automático (útil em testes)
JOBS_ATIVOS=true

# ── Senha Única USP (credenciais fornecidas pela STI) ─────────────────────
SENHAUNICA_KEY=
SENHAUNICA_SECRET=
SENHAUNICA_CALLBACK_ID=
# true = ambiente de testes dev.uspdigital.usp.br
SENHAUNICA_DEV=true
# Números USP que entram como administradores no primeiro acesso (separados por vírgula)
SENHAUNICA_ADMINS=
# true = login simulado, sem a USP (só funciona com NODE_ENV=development; NUNCA use em produção)
SENHAUNICA_FAKE=false

# ── E-mail (opcional; sem SMTP, as notificações ficam só no sistema) ──────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
